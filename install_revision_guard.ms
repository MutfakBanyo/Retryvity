-- RevisionGuard sürükle-bırak kurulumu.
--
-- KULLANIM:
--   1. Bu dosya "revision_guard" klasörünün yanında (repo kök dizininde)
--      kalmalı, başka yere taşıma.
--   2. Dosyayı Explorer'dan 3ds Max viewport'una sürükleyip bırak.
--   3. RevisionGuard paneli hemen açılır ve ana menüye "RevisionGuard"
--      menüsü eklenir.
--
-- Tekrar çalıştırmak güvenlidir: menü veya path kaydı çoğaltmaz.

(
	local repoRoot = getFilenamePath (getThisScriptFilename())
	local helpersPath = repoRoot + @"revision_guard\maxscript\helpers.ms"

	if not (doesFileExist helpersPath) then (
		messageBox (
			"RevisionGuard kurulumu başarısız oldu.\n\n" +
			"Beklenen dosya bulunamadı:\n" + helpersPath + "\n\n" +
			"Bu installer dosyasını 'revision_guard' klasörünün yanından " +
			"(repo kök dizininden) çalıştırdığından emin ol."
		) title:"RevisionGuard - Kurulum Hatası"
		return()
	)

	-- Python raw string'leri tek ters bölü ile bitemez; sys.path girdisi
	-- için düz bölü kullanıyoruz (Windows/Python ikisini de kabul eder).
	local repoRootForPython = substituteString repoRoot "\\" "/"
	local pyPathLine = "import sys; _p = r'" + repoRootForPython + "'; sys.path.append(_p) if _p not in sys.path else None"

	-- 1. Repoyu Python'dan import edilebilir yap.
	python.Execute pyPathLine

	-- 2. macroScript'leri kaydet.
	try (
		fileIn helpersPath
	) catch (
		format "RevisionGuard: macroScript registration skipped (%)\n" (getCurrentException())
	)

	-- 3. Her 3ds Max açılışında 1-2 adımlarının otomatik çalışması için
	--    startup script yaz.
	local startupFile = (getDir #userStartupScripts) + "\\RevisionGuard_Startup.ms"
	local startupWriteOk = true

	try (
		local f = createFile startupFile
		format "-- Auto-generated by the RevisionGuard drag-and-drop installer.\n" to:f
		format "-- Delete this file to remove RevisionGuard's auto-load.\n" to:f
		format "python.Execute \"%\"\n" pyPathLine to:f
		format "if doesFileExist @\"%\" then fileIn @\"%\"\n" helpersPath helpersPath to:f
		close f
	) catch (
		startupWriteOk = false
	)

	if not startupWriteOk then (
		messageBox (
			"RevisionGuard bu oturum için açıldı, ama otomatik başlatma " +
			"dosyası yazılamadı:\n" + startupFile + "\n\n" +
			"3ds Max'i her açtığında bu .ms dosyasını tekrar sürükleyip " +
			"bırakman gerekebilir."
		) title:"RevisionGuard - Kısmi Kurulum"
	)

	-- 4. Ana menüye "RevisionGuard" menüsünü ekle (idempotent).
	try (
		local mainMenu = menuMan.getMainMenuBar()
		local rgMenu = menuMan.findMenu "RevisionGuard"
		if rgMenu == undefined then (
			rgMenu = menuMan.createMenu "RevisionGuard"
			local subMenuItem = menuMan.createSubMenuItem "RevisionGuard" rgMenu
			mainMenu.addItem subMenuItem mainMenu.numItems()
		)
		if rgMenu.numItems() == 0 then (
			local launchItem = menuMan.createActionItem "RevisionGuard_Launch" "RevisionGuard"
			if launchItem != undefined then rgMenu.addItem launchItem -1
			local smokeItem = menuMan.createActionItem "RevisionGuard_SmokeTest" "RevisionGuard"
			if smokeItem != undefined then rgMenu.addItem smokeItem -1
		)
		menuMan.updateMenuBar()
	) catch (
		format "RevisionGuard: menu setup skipped (%)\n" (getCurrentException())
	)

	-- 5. Paneli hemen aç. Doğrudan python.Execute ile çağrılıyor çünkü
	--    iç içe fileIn ile tanımlanan fonksiyon bu script'in kendi
	--    kapsamında güvenilir biçimde görünmüyor.
	python.Execute "from revision_guard.bootstrap import show_revision_guard; show_revision_guard()"

	messageBox (
		"RevisionGuard kuruldu.\n\n" +
		"Panel şimdi açıldı. Bir sonraki 3ds Max açılışında otomatik " +
		"yüklenecek; üst menüdeki 'RevisionGuard' menüsünden tekrar " +
		"açabilirsin.\n\n" +
		"Motoru doğrulamak için aynı menüdeki 'RevisionGuard Smoke Test' " +
		"komutunu çalıştırabilirsin."
	) title:"RevisionGuard - Kurulum Tamamlandı"
)
