/* Corona Doctor dark theme.
   Values here must mirror corona_doctor/ui/design/colors.py, metrics.py
   and typography.py. This file is loaded and token-substituted by
   ui/themes/__init__.py:load_dark_theme() rather than referenced by
   raw path, so the Python tokens remain the single source of truth. */

QWidget {
    background-color: {BACKGROUND};
    color: {TEXT_PRIMARY};
    font-family: {FONT_FAMILY};
    font-size: {BODY_SIZE}px;
}

QWidget#Surface {
    background-color: {SURFACE};
    border: 1px solid {BORDER_SUBTLE};
    border-radius: {RADIUS_MEDIUM}px;
}

/* A slightly raised/elevated surface — major static panels (e.g. the
   Scene Health card, the About screen's author card). The faint top
   highlight + bottom-darkened border simulate tonal "glass" depth
   cheaply (static gradient, no blur/translucency) — see
   docs/ARCHITECTURE.md, "Glass/depth language". */
QWidget#SurfaceRaised {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 {SURFACE_OVERLAY}, stop:1 {SURFACE_RAISED});
    border: 1px solid {BORDER};
    border-radius: {RADIUS_MEDIUM}px;
}

QLabel#Display {
    font-size: {DISPLAY_SIZE}px;
    font-weight: 700;
    color: {TEXT_PRIMARY};
}

QLabel#Title {
    font-size: {TITLE_SIZE}px;
    font-weight: 700;
    color: {TEXT_PRIMARY};
}

QLabel#SectionTitle {
    font-size: {SECTION_TITLE_SIZE}px;
    font-weight: 600;
    color: {TEXT_PRIMARY};
}

QLabel#BodyEmphasis {
    font-size: {BODY_EMPHASIS_SIZE}px;
    font-weight: 600;
    color: {TEXT_PRIMARY};
}

QLabel#Caption {
    font-size: {CAPTION_SIZE}px;
    color: {TEXT_MUTED};
}

QLabel#Secondary {
    font-size: {SECONDARY_SIZE}px;
    color: {TEXT_SECONDARY};
}

QPushButton {
    font-size: {BUTTON_SIZE}px;
}

QPushButton#Primary {
    background-color: {ACCENT};
    color: {TEXT_ON_ACCENT};
    border: none;
    border-radius: {RADIUS_SMALL}px;
    padding: {SPACING_SM}px {SPACING_LG}px;
    font-weight: 600;
}

QPushButton#Primary:hover {
    background-color: {ACCENT_HOVER};
}

QPushButton#Primary:disabled {
    background-color: {SURFACE_OVERLAY};
    color: {TEXT_MUTED};
}

QPushButton#Secondary {
    background-color: {SURFACE_RAISED};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: {RADIUS_SMALL}px;
    padding: {SPACING_SM}px {SPACING_LG}px;
}

QPushButton#Secondary:hover {
    background-color: {SURFACE_OVERLAY};
}

QPushButton#NavItem {
    text-align: left;
    background-color: transparent;
    color: {TEXT_SECONDARY};
    border: none;
    border-radius: {RADIUS_SMALL}px;
    padding: {SPACING_SM}px {SPACING_MD}px;
    font-size: {BODY_SIZE}px;
}

QPushButton#NavItem:hover {
    background-color: {SURFACE_RAISED};
    color: {TEXT_PRIMARY};
}

QPushButton#NavItem:checked {
    background-color: {ACCENT_MUTED};
    color: {TEXT_PRIMARY};
    font-weight: 600;
}

QLineEdit, QComboBox {
    background-color: {SURFACE_RAISED};
    border: 1px solid {BORDER};
    border-radius: {RADIUS_SMALL}px;
    padding: {SPACING_XS}px {SPACING_SM}px;
    font-size: {BODY_SIZE}px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid {ACCENT};
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QTableView {
    background-color: transparent;
    border: none;
    gridline-color: {BORDER_SUBTLE};
    font-size: {TABLE_SIZE}px;
    selection-background-color: {ACCENT_MUTED};
    selection-color: {TEXT_PRIMARY};
}

QTableView::item {
    padding: {SPACING_XS}px {SPACING_SM}px;
}

QHeaderView::section {
    background-color: {SURFACE};
    color: {TEXT_SECONDARY};
    border: none;
    border-bottom: 1px solid {BORDER};
    padding: {SPACING_SM}px;
    font-size: {SECONDARY_SIZE}px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: {BORDER};
    border-radius: {RADIUS_SMALL}px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: {TEXT_MUTED};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QListView {
    background-color: transparent;
    border: none;
    outline: none;
    font-size: {TABLE_SIZE}px;
}

QFrame#Divider {
    background-color: {BORDER_SUBTLE};
    max-height: 1px;
    min-height: 1px;
}
