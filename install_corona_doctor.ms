-- Corona Doctor drag-and-drop installer.
--
-- HOW TO USE:
--   1. Make sure this file stays in the same folder as the
--      "corona_doctor" folder (i.e. don't move it out of the repo root).
--   2. Drag this .ms file and drop it onto the 3ds Max viewport.
--   3. Corona Doctor opens immediately, and a "Corona Doctor" menu is
--      added to the main menu bar for future sessions.
--
-- What this does:
--   - Registers this repo's folder on 3ds Max's Python sys.path
--     (via a small startup script written into your user startup
--     scripts folder, so it persists across 3ds Max restarts).
--   - Registers the CoronaDoctor_Launch macroScript
--     (corona_doctor/maxscript/helpers.ms).
--   - Adds a "Corona Doctor" main menu with a "Launch" item.
--   - Opens the Corona Doctor panel right away so you don't have to
--     restart 3ds Max to see it work.
--
-- Safe to re-run: running this again just re-confirms the setup, it
-- does not create duplicate menus or duplicate path entries.

(
	local repoRoot = getFilenamePath (getThisScriptFilename())
	local helpersPath = repoRoot + @"corona_doctor\maxscript\helpers.ms"

	if not (doesFileExist helpersPath) then (
		messageBox (
			"Corona Doctor kurulumu başarısız oldu.\n\n" +
			"Beklenen dosya bulunamadı:\n" + helpersPath + "\n\n" +
			"Bu installer dosyasını 'corona_doctor' klasörünün yanından " +
			"(repo kök dizininden) çalıştırdığından emin ol."
		) title:"Corona Doctor - Kurulum Hatası"
		return()
	)

	-- Python raw strings can't end in a single backslash, so use
	-- forward slashes for the sys.path entry (Windows/Python accept
	-- forward slashes in paths interchangeably).
	local repoRootForPython = substituteString repoRoot "\\" "/"
	local pyPathLine = "import sys; _p = r'" + repoRootForPython + "'; sys.path.append(_p) if _p not in sys.path else None"

	-- 1. Make the repo importable from Python, right now.
	python.Execute pyPathLine

	-- 2. Register the macroScript (defines launchCoronaDoctor() and the
	--    CoronaDoctor_Launch macroScript) for this session. Wrapped in
	--    try/catch so a problem here doesn't block opening the panel
	--    directly in step 5 below.
	try (
		fileIn helpersPath
	) catch (
		format "Corona Doctor: macroScript registration skipped (%)\n" (getCurrentException())
	)

	-- 3. Write a startup script so steps 1-2 happen automatically every
	--    time 3ds Max opens, without needing to drag this file again.
	local startupDir = getDir #userStartupScripts
	local startupFile = startupDir + "\\CoronaDoctor_Startup.ms"
	local startupWriteOk = true

	try (
		local f = createFile startupFile
		format "-- Auto-generated by Corona Doctor's drag-and-drop installer.\n" to:f
		format "-- Safe to delete this file to uninstall Corona Doctor's auto-load.\n" to:f
		format "python.Execute \"%\"\n" pyPathLine to:f
		format "if doesFileExist @\"%\" then fileIn @\"%\"\n" helpersPath helpersPath to:f
		close f
	) catch (
		startupWriteOk = false
	)

	if not startupWriteOk then (
		messageBox (
			"Corona Doctor bu oturum için açıldı, ama otomatik başlatma " +
			"dosyası yazılamadı:\n" + startupFile + "\n\n" +
			"3ds Max'i her açtığında bu .ms dosyasını tekrar sürükleyip " +
			"bırakman gerekebilir."
		) title:"Corona Doctor - Kısmi Kurulum"
	)

	-- 4. Add a "Corona Doctor" main menu item (idempotent).
	try (
		local mainMenu = menuMan.getMainMenuBar()
		local cdMenu = menuMan.findMenu "Corona Doctor"
		if cdMenu == undefined then (
			cdMenu = menuMan.createMenu "Corona Doctor"
			local subMenuItem = menuMan.createSubMenuItem "Corona Doctor" cdMenu
			mainMenu.addItem subMenuItem mainMenu.numItems()
		)
		if cdMenu.numItems() == 0 then (
			local actionItem = menuMan.createActionItem "CoronaDoctor_Launch" "Corona Doctor"
			if actionItem != undefined then cdMenu.addItem actionItem -1
		)
		menuMan.updateMenuBar()
	) catch (
		format "Corona Doctor: menu setup skipped (%)\n" (getCurrentException())
	)

	-- 5. Open the panel right now. Called directly via python.Execute
	--    (rather than the launchCoronaDoctor() MAXScript function defined
	--    by the fileIn above) because a function defined by a nested
	--    fileIn is not reliably visible in this script's own scope.
	python.Execute "from corona_doctor.bootstrap import show_corona_doctor; show_corona_doctor()"

	messageBox (
		"Corona Doctor kuruldu.\n\n" +
		"Panel şimdi açıldı. Bir sonraki 3ds Max açılışında otomatik " +
		"olarak yüklenecek ve üst menüde 'Corona Doctor' menüsünden " +
		"tekrar açabileceksin."
	) title:"Corona Doctor - Kurulum Tamamlandı"
)
